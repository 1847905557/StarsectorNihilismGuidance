root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{md,java}]
indent_size = 4

[*.gradle]
indent_style = tab
indent_size = 4

[*.{png,jpg,jpeg,gif,ico,ogg,wav,jar,zip,ttf}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
