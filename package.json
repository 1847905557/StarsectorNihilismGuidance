{
  "name": "StarsectorNihilismGuidance",
  "version": "1.0.0",
  "description": "Nihilism Guidance By Nihilist",
  "main": "index.js",
  "scripts": {
    "docs:dev": "vuepress dev docs",
    "docs:build": "vuepress build docs",
    "format": "prettier --log-level warn --write .",
    "format:check": "prettier --log-level warn --check .",
    "check:text": "node tools/check-text.mjs",
    "check:docs": "node tools/check-docs.mjs",
    "check:fixtures": "node tools/check-fixtures.mjs",
    "explain:ignore": "node tools/explain-ignore.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm check:text && pnpm check:docs && pnpm check:fixtures",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "lint:full": "eslint . --config eslint.full.config.mjs --max-warnings 0",
    "test:tools": "node tools/test-tools.mjs",
    "test:dev-edit": "vitest run",
    "test:dev-edit:failed": "vitest run --lastFailed --passWithNoTests",
    "test:dev-edit:changed": "vitest run --sinceLastRun",
    "test:browser": "playwright test",
    "test:browser:list": "playwright test --list",
    "typecheck": "pnpm typecheck:client && pnpm typecheck:node && pnpm typecheck:test && pnpm typecheck:tools",
    "typecheck:client": "vue-tsc -p tsconfig.client.json",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "typecheck:test": "vue-tsc -p tsconfig.test.json",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "ci:code": "pnpm lint && pnpm lint:full && pnpm typecheck && pnpm test:tools && pnpm test:dev-edit"
  },
  "keywords": [],
  "author": "Nihilist",
  "license": "GPL",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.21.0",
    "pnpm": ">=12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lucide/vue": "1.72.0",
    "@tiptap/core": "3.33.1",
    "@tiptap/extension-code": "3.33.1",
    "@tiptap/extension-code-block": "3.33.1",
    "@tiptap/extension-image": "3.33.1",
    "@tiptap/extension-link": "3.33.1",
    "@tiptap/extension-list": "3.33.1",
    "@tiptap/extension-table": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "@types/node": "24.19.2",
    "@vuepress/bundler-vite": "2.0.0-rc.31",
    "@vuepress/theme-default": "2.0.0-rc.137",
    "chokidar": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "ignore": "7.0.14",
    "jsdom": "31.0.0",
    "markdown-it": "15.0.3",
    "prettier": "3.10.1",
    "sass-embedded": "1.108.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "vue-eslint-parser": "10.4.2",
    "vuepress": "2.0.0-rc.31",
    "vite": "8.3.8",
    "@types/jsdom": "30.0.0",
    "@playwright/test": "1.65.0",
    "@types/markdown-it": "14.2.0",
    "vue-tsc": "3.3.14"
  },
  "type": "module"
}
